# ===== API KEYS =====
# Nếu bạn sử dụng OpenRouter (mặc định)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Nếu bạn sử dụng Gemini trực tiếp từ Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# ===== CẤU HÌNH SERVER =====
PORT=3000

# ===== CẤU HÌNH PROVIDER & MODEL =====
# API_PROVIDER có thể là: "openrouter" hoặc "gemini"
API_PROVIDER=openrouter

# Tên model tương ứng với Provider
# - Nếu API_PROVIDER=openrouter, bạn có thể dùng các model như:
#   + openai/gpt-oss-20b:free
#   + google/gemma-2-9b-it:free (có thể không ổn định)
#   + meta-llama/llama-3-8b-instruct:free
#
# - Nếu API_PROVIDER=gemini, bạn có thể dùng:
#   + gemini-1.5-flash
#   + gemini-1.5-pro
LLM_MODEL=openai/gpt-oss-20b:free
